{
  "general": {
    "library_scope": "project",
    "lib_prefix": "JLCPCB",
    "lib_path": "${KIPRJMOD}/library",
    "lib_format": "easyeda_pro",
    "kicad_builtin_first": true,
    "kicad_symbol_matching_enabled": false,
    "kicad_symbol_index_ttl_sec": 86400,
    "kicad_symbol_index_max_libs": 300,
    "kicad_footprint_fuzzy_max_libs": 12,
    "kicad_footprint_fuzzy_max_files_per_lib": 2500,
    "kicad_symbol_wildcard_min_score": 80,
    "kicad_symbol_wildcard_min_gap": 14,
    "kicad_footprint_fuzzy_min_score_passive": 70,
    "kicad_footprint_fuzzy_min_score_ic": 95,
    "kicad_footprint_fuzzy_min_gap_passive": 16,
    "kicad_footprint_fuzzy_min_gap_nonpassive": 12,
    "kicad_footprint_strict_pkg_pin_min_gap": 14,
    "kicad_footprint_require_keyword_overlap": true,
    "kicad_footprint_passive_size_strict_mode": true,
    "hide_button_labels": false,
    "debug_log": false,
    "kicad_symbol_map": {
      "resistor": ["Device:R", "Device:R_Small", "Device:R_US"],
      "capacitor": ["Device:C", "Device:C_Small", "Device:C_Polarized"],
      "inductor": ["Device:L", "Device:L_Small"],
      "diode": ["Device:D", "Device:D_Small"],
      "led": ["Device:LED", "Device:LED_Small"],
      "bjt": ["Transistor_BJT:Q_NPN_BCE", "Transistor_BJT:Q_PNP_BCE"],
      "fet": ["Transistor_FET:Q_NMOS_GDS", "Transistor_FET:Q_PMOS_GDS"],
      "ic": ["Device:U"]
    },
    "kicad_footprint_map": {}
  }
}
